ANGELSPEC_ROOT=/path/to/AngelSpec
ANGELSPEC_HOSTFILE=/etc/angelspec/hostfile
ANGELSPEC_PYTHON=/usr/bin/python3
ANGELSPEC_SSH_USER=root
ANGELSPEC_SSH_KEY=$HOME/.ssh/id_rsa
ANGELSPEC_RAY_PORT=6379
ANGELSPEC_RAY_MIN_WORKER_PORT=10002
ANGELSPEC_RAY_MAX_WORKER_PORT=19999
ANGELSPEC_CPUS_PER_NODE=16
ANGELSPEC_GPUS_PER_NODE=8
ANGELSPEC_OBJECT_STORE_MEMORY=200000000000
ANGELSPEC_DEFAULT_CONFIG=configs/vllm_hy_v4_flash_dfly2_256k.yaml

ANGELSPEC_NUM_NODES=4
ANGELSPEC_TRAIN_NODES=2
ANGELSPEC_TRAIN_GPUS_PER_NODE=8
ANGELSPEC_INFER_NODES=2

export HY_V4_FLASH_TARGET_MODEL=/path/to/hy-v4-flash
export HY_V4_FLASH_TRAIN_DATA=/path/to/train.jsonl
export ANGELSPEC_RUN_DIR=/path/to/run

export PATH=/usr/local/bin:/usr/bin:/bin
export PYTHONPATH="$ANGELSPEC_ROOT"
export LD_LIBRARY_PATH=/path/to/cuda/lib64:/path/to/torch/lib
export NCCL_SOCKET_IFNAME=eth0
export GLOO_SOCKET_IFNAME=eth0
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export RAY_prestart_worker_first_driver=false
